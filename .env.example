APP_NAME="سلات ليبيا"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================
# DATABASE - MYSQL ONLY
# =========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salltak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CART_IMPORT_TIMEOUT=30

# SHEIN Browser Importer - Playwright + Chromium
SHEIN_BROWSER_ENABLED=true
# On Laragon set this to the real output of: where node
SHEIN_BROWSER_NODE=node
SHEIN_BROWSER_HEADLESS=true
SHEIN_BROWSER_TIMEOUT_MS=35000
SHEIN_BROWSER_PROCESS_TIMEOUT=110
SHEIN_BROWSER_MANUAL_CHALLENGE_WAIT_MS=60000
# Leave empty to use storage/app/shein-browser-profile
SHEIN_BROWSER_PROFILE_DIR=

# Demo Seeder Accounts - change before production
DEMO_ADMIN_EMAIL=admin@cartly.test
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_MANAGER_EMAIL=manager@cartly.test
DEMO_MANAGER_PASSWORD=Manager@123456
DEMO_CUSTOMER_EMAIL=customer@cartly.test
DEMO_CUSTOMER_PASSWORD=Customer@123
